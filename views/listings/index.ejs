<%- layout("/layouts/boilerplate.ejs") %>

<div id="filters">
    <a href="/listings" class="filter-link">
        <div class="filter <%= !category ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-house"></i></div>
            <p>All</p>
        </div>
    </a>

    <a href="/listings?category=Rooms" class="filter-link">
        <div class="filter <%= category === 'Rooms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
    </a>

    <a href="/listings?category=Iconic%20Cities" class="filter-link">
        <div class="filter <%= category === 'Iconic Cities' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
    </a>

    <a href="/listings?category=Mountains" class="filter-link">
        <div class="filter <%= category === 'Mountains' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
    </a>

    <a href="/listings?category=Castles" class="filter-link">
        <div class="filter <%= category === 'Castles' ? 'active-filter' : '' %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
    </a>

    <a href="/listings?category=Amazing%20Pools" class="filter-link">
        <div class="filter <%= category === 'Amazing Pools' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
    </a>

    <a href="/listings?category=Camping" class="filter-link">
        <div class="filter <%= category === 'Camping' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
    </a>

    <a href="/listings?category=Farms" class="filter-link">
        <div class="filter <%= category === 'Farms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
    </a>

    <a href="/listings?category=Arctic" class="filter-link">
        <div class="filter <%= category === 'Arctic' ? 'active-filter' : '' %>">
            <div><i class="fa-regular fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
    </a>

    <a href="/listings?category=Domes" class="filter-link">
        <div class="filter <%= category === 'Domes' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </div>
    </a>

    <a href="/listings?category=Boats" class="filter-link">
        <div class="filter <%= category === 'Boats' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </div>
    </a>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<!--  card for each listing -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(listing of allListings) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b><br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> for night
                        <i class="tax-info">&nbsp; &nbsp; +18% GST </i>
                        <% if(listing.reviews.length > 0) { %>
                            &nbsp;
                            <i class="fa-solid fa-circle" style="opacity: 0.4; font-size: 0.2rem;"></i>
                            &nbsp;
                            <% let avgRating = listing.reviews.reduce((total, review) => total + review.rating, 0) / listing.reviews.length; %>
                            <i class="fa-solid fa-star" style="opacity: 0.7; font-size: 0.7rem"></i>&nbsp;<%= avgRating.toFixed(1) %>
                        <% } %>
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div>

<script src="../JS/script.js"></script>